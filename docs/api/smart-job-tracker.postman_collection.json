    {
      "name": "Jobs",
      "description": "Run this folder in order. 'Create job' stores the new id in the jobId collection variable and everything after it reads that variable, so the folder works as one end-to-end flow rather than six isolated requests.",
      "item": [
        {
          "name": "Create job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{appOrigin}}",
                "description": "Browsers attach Origin to every non-GET request, same-origin ones included. Newman does not, so without this line no run here can see a CORS mapping refusing the app's own writes."
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"company\": \"Acme Corp\",\n  \"roleTitle\": \"Backend Engineer\",\n  \"location\": \"Remote\",\n  \"status\": \"WISHLIST\",\n  \"jobUrl\": \"https://example.com/jobs/1\",\n  \"salaryMin\": 90000.00,\n  \"salaryMax\": 120000.00,\n  \"description\": \"Build and maintain backend services.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"]
            },
            "description": "Every field is optional except company and roleTitle. Omitting status defaults it to WISHLIST in CreateJobCommand rather than in the request DTO.\n\nThis request sends an Origin header, as Update job and Delete job do, and it is not decoration. A browser sends Origin on every write, so a CORS mapping that does not list the app's own origin answers 403 to all of them while reads keep working. That defect shipped through three tasks because nothing here, and no curl check, sent the header. All three writes carry it because a mapping can restrict methods as well as origins, which would break edit and delete while leaving create working. See docs/engineering/same-origin-api-boundary.md."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('the backend applied no CORS processing', function () {",
                  "    pm.expect(",
                  "        pm.response.code,",
                  "        'a 403 here means a CORS mapping is refusing the origin the app is served '",
                  "        + 'from, so every browser write fails while reads keep working. See '",
                  "        + 'docs/engineering/same-origin-api-boundary.md.',",
                  "    ).to.not.eql(403);",
                  "",
                  "    pm.expect(",
                  "        pm.response.headers.has('Access-Control-Allow-Origin'),",
                  "        'an allow-origin header means a CORS mapping exists. Allowing this origin '",
                  "        + 'explicitly, or allowing every origin, both answer the symptom instead of '",
                  "        + 'removing the check, and the second opens the API to any site.',",
                  "    ).to.eql(false);",
                  "});",
                  "",
                  "const job = pm.response.json();",
                  "",
                  "pm.test('returns a server-assigned id', function () {",
                  "    pm.expect(job.id).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "pm.test('echoes the submitted fields', function () {",
                  "    pm.expect(job.company).to.eql('Acme Corp');",
                  "    pm.expect(job.roleTitle).to.eql('Backend Engineer');",
                  "    pm.expect(job.status).to.eql('WISHLIST');",
                  "});",
                  "",
                  "pm.test('does not leak userId into the HTTP contract', function () {",
                  "    pm.expect(job).to.not.have.property('userId');",
                  "});",
                  "",
                  "pm.collectionVariables.set('jobId', job.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"]
            },
            "description": "Returns every job ordered by updatedAt descending, so the job just created or edited is first."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const jobs = pm.response.json();",
                  "",
                  "pm.test('includes the job created by this run', function () {",
                  "    const ids = jobs.map(function (job) { return job.id; });",
                  "    pm.expect(ids).to.include(pm.collectionVariables.get('jobId'));",
                  "});",
                  "",
                  "pm.test('is ordered by updatedAt, newest first', function () {",
                  "    const timestamps = jobs.map(function (job) { return Date.parse(job.updatedAt); });",
                  "    const sorted = timestamps.slice().sort(function (a, b) { return b - a; });",
                  "    pm.expect(timestamps).to.eql(sorted);",
                  "});"
                ]
              }
            }
          ]
        },
