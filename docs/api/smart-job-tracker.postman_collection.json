{
  "info": {
    "name": "Smart Job Tracker",
    "description": "Hand-maintained happy-path and error flows for the Smart Job Tracker backend.\n\nThis collection is deliberately NOT an exhaustive endpoint list. The generated OpenAPI document at {{baseUrl}}/v3/api-docs is the exhaustive list, and it cannot drift from the controllers. Import that when you want every endpoint with every field.\n\nWhat lives here instead is the part a spec cannot express: ordered flows that chain one response into the next request, and assertions that pin the API contract.\n\nSelect the 'Smart Job Tracker - Local' environment before running. Run the 'Jobs' folder with the Collection Runner to execute the full create-read-update-delete cycle in order. Run the 'Tasks' folder the same way for a job's tasks; it seeds its own job rather than depending on the 'Jobs' folder having run first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "jobId",
      "value": "",
      "type": "string",
      "description": "Set by 'Create job'. Every later request in the Jobs folder reads it."
    },
    {
      "key": "taskJobId",
      "value": "",
      "type": "string",
      "description": "Set by 'Create job for tasks'. Every later request in the Tasks folder reads it. Separate from jobId so the Tasks folder does not depend on the Jobs folder having run first."
    },
    {
      "key": "taskId",
      "value": "",
      "type": "string",
      "description": "Set by 'Create task'. Later requests in the Tasks folder read it."
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
