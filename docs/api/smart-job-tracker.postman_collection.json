                  "pm.test('preserves identity and creation time', function () {",
                  "    pm.expect(job.id).to.eql(pm.collectionVariables.get('jobId'));",
                  "    pm.expect(Date.parse(job.updatedAt)).to.be.at.least(Date.parse(job.createdAt));",
                  "});"
                ]
