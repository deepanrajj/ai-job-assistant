        {
          "name": "Delete task",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Origin",
                "value": "{{appOrigin}}",
                "description": "Browsers attach Origin to every non-GET request, same-origin ones included. Newman does not, so without this line no run here can see a CORS mapping refusing the app's own writes."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{taskJobId}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{taskJobId}}", "tasks", "{{taskId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});",
                  "",
                  "pm.test('the backend applied no CORS processing', function () {",
                  "    pm.expect(",
                  "        pm.response.code,",
                  "        'a 403 here means a CORS mapping is refusing the origin the app is served '",
                  "        + 'from, so every browser write fails while reads keep working. See '",
                  "        + 'docs/engineering/same-origin-api-boundary.md.',",
                  "    ).to.not.eql(403);",
                  "",
                  "    pm.expect(",
                  "        pm.response.headers.has('Access-Control-Allow-Origin'),",
                  "        'an allow-origin header means a CORS mapping exists. Allowing this origin '",
                  "        + 'explicitly, or allowing every origin, both answer the symptom instead of '",
                  "        + 'removing the check, and the second opens the API to any site.',",
                  "    ).to.eql(false);",
                  "});",
                  "",
                  "pm.test('returns an empty body', function () {",
                  "    pm.expect(pm.response.text()).to.be.empty;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete deleted task returns 404",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Origin",
                "value": "{{appOrigin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/jobs/{{taskJobId}}/tasks/{{taskId}}",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{taskJobId}}", "tasks", "{{taskId}}"]
            },
            "description": "Runs immediately after Delete task. Proves the delete actually removed the row: deleting the same id again is now a missing task, not a missing job."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('uses the TASK_NOT_FOUND error code', function () {",
                  "    pm.expect(pm.response.json().code).to.eql('TASK_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create task with blank title returns 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/{{taskJobId}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{taskJobId}}", "tasks"]
            },
            "description": "Bean Validation rejects the blank title before the service runs. The response carries per-field detail in fieldErrors."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 400', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "const error = pm.response.json();",
                  "",
                  "pm.test('uses the VALIDATION_FAILED error code', function () {",
                  "    pm.expect(error.code).to.eql('VALIDATION_FAILED');",
                  "});",
                  "",
                  "pm.test('names the offending field', function () {",
                  "    const fields = error.fieldErrors.map(function (fieldError) { return fieldError.field; });",
                  "    pm.expect(fields).to.include('title');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Create task for missing job returns 404",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Prepare portfolio\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/jobs/{{$guid}}/tasks",
              "host": ["{{baseUrl}}"],
              "path": ["jobs", "{{$guid}}", "tasks"]
            },
            "description": "{{$guid}} generates a well-formed but unused UUID, so this is a genuine 'job does not exist' case rather than a malformed id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 404', function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test('uses the JOB_NOT_FOUND error code', function () {",
                  "    pm.expect(pm.response.json().code).to.eql('JOB_NOT_FOUND');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "AI",
      "description": "These call OpenAI for real and cost money. They need OPENAI_API_KEY set in the backend environment, not in Postman - the browser and Postman never hold the key. Without it the backend returns AI_REQUEST_FAILED, which is the correct behaviour, not a broken collection.",
      "item": [
        {
          "name": "Analyze job",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"We are hiring a backend engineer with strong Kotlin and Spring Boot experience. You will design REST APIs, own PostgreSQL schema design, and work with a small product team.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/ai/analyze-job",
              "host": ["{{baseUrl}}"],
              "path": ["ai", "analyze-job"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds 200 or a typed AI error, never a raw stack trace', function () {",
                  "    pm.expect([200, 502]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code !== 200) {",
                  "    pm.test('failure is a typed API error', function () {",
                  "        pm.expect(pm.response.json().code).to.be.oneOf(['AI_REQUEST_FAILED', 'AI_RESPONSE_INVALID']);",
                  "    });",
                  "}"
                ]
              }
            }
          ]
        },
