# Docker Compose environment for the full local stack.
#
# Copy this file to infra/docker/.env and edit the values you need.
# Compose loads .env from this directory automatically, so no
# --env-file flag is required:
#
#   cp infra/docker/.env.example infra/docker/.env
#
# .env is gitignored. Never commit real values.
#
# Every variable below has a working default baked into
# infra/docker/compose.yaml, so the stack starts even with no .env file
# at all. Set a variable here only to override its default.

# OpenAI API key. No default, because it is a real credential.
# Left blank, Compose warns and the backend starts normally; only the
# /api/ai/* endpoints fail. Set it to use the AI features.
OPENAI_API_KEY=

# OpenAI endpoint and model. Defaults match
# infra/k8s/local/backend-configmap.yaml.
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5.4

# PostgreSQL database name, user, and password.
#
# The password default is smartjobtracker, the same value already
# committed as the DB_PASSWORD default in
# backend/src/main/resources/application.properties.
#
# That default is only defensible because compose.yaml publishes the
# database as "127.0.0.1:5434:5432". A bare "5434:5432" would bind every
# interface and expose it to the local network with a password anyone
# can read in this repository. If you ever change that mapping, change
# the password handling too.
#
# The local Kubernetes runtime is different: there the password comes
# from the smart-job-tracker-secrets Secret and has no default.
#
# Changing POSTGRES_DB or POSTGRES_USER after the first start has no
# effect on an existing volume, because the postgres image only
# initialises the database once. Run npm run compose:reset to start over.
POSTGRES_DB=smartjobtracker
POSTGRES_USER=smartjobtracker
POSTGRES_PASSWORD=smartjobtracker
